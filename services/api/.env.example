# AgriSmart API Configuration
PROJECT_NAME="AgriSmart API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEMO_MODE=true

# Server
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

